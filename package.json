{
  "name": "ost",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "sim": "tsx sim/main.ts",
    "carte": "tsx sim/carte.ts",
    "carte:stats": "tsx sim/carte-stats.ts",
    "carte:fragilite": "tsx sim/carte-fragilite.ts",
    "combat": "tsx sim/combat.ts",
    "combat:dominance": "tsx sim/combat-dominance.ts",
    "campagne": "tsx sim/campagne-cli.ts",
    "test": "vitest run",
    "test:watch": "vitest",
